# Copy to .env.docker and change both occurrences of the local-only password.
# Percent-encode reserved characters in DATABASE_URL if you use them in the password.
POSTGRES_DB=hcg
POSTGRES_USER=hcg
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql+psycopg://hcg:change-me-local-only@postgres:5432/hcg
REDIS_URL=redis://redis:6379/0
HCG_ENV=development
HCG_ENABLE_DEMO_FALLBACK=false
# Set a long random value before enabling administrative job endpoints.
HCG_JOBS_ADMIN_TOKEN=
