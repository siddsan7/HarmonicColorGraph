# Supabase Postgres connection string.
# Pooler format, recommended for local scripts and deployed/serverless environments:
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-1-us-west-2.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+psycopg://postgres.bqaateqbbavwnbyfuqvk:<password>@aws-1-us-west-2.pooler.supabase.com:5432/postgres
#
# Direct connection format, valid in environments with IPv6 database access:
# DATABASE_URL=postgresql+psycopg://postgres:<password>@db.bqaateqbbavwnbyfuqvk.supabase.co:5432/postgres

# Demo fallback must be explicit. Keep false for real Supabase-backed behavior.
HCG_ENABLE_DEMO_FALLBACK=false

# F71 assistant models. Export the API key into the process environment;
# never commit its value.
# ANTHROPIC_API_KEY=<your-key>
HCG_LLM_MODEL=claude-sonnet-5
HCG_LLM_FAST_MODEL=claude-haiku-4-5-20251001

# F73 assistant controls. Set HCG_IP_HASH_SECRET to a private random value in
# each deployment so stored IP hashes cannot be guessed from public IP lists.
HCG_DAILY_AI_BUDGET_USD=2.00
# HCG_IP_HASH_SECRET=<private-random-value>
# For custom model pricing, set both INPUT and OUTPUT rates in USD per million:
# HCG_LLM_INPUT_USD_PER_MTOK=3
# HCG_LLM_OUTPUT_USD_PER_MTOK=15
# HCG_LLM_FAST_INPUT_USD_PER_MTOK=1
# HCG_LLM_FAST_OUTPUT_USD_PER_MTOK=5

# Local full-library ingestion inputs. Do not commit large Chordonomicon files.
CHORDONOMICON_SOURCE_PATH=../data/raw/chordonomicon_v2.csv
CHORDONOMICON_METRICS_OUTPUT=../data/processed/phase1_quality_metrics.json
