# Supabase Postgres connection string.
# Direct connection format:
# DATABASE_URL=postgresql+psycopg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
#
# Pooler format, when preferred for deployed/serverless environments:
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-us-west-2.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+psycopg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Demo fallback must be explicit. Keep false for real Supabase-backed behavior.
HCG_ENABLE_DEMO_FALLBACK=false

# Local full-library ingestion inputs. Do not commit large Chordonomicon files.
CHORDONOMICON_SOURCE_PATH=../data/raw/chordonomicon.jsonl
CHORDONOMICON_METRICS_OUTPUT=../data/processed/phase1_quality_metrics.json
