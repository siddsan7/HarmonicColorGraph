# Same-origin API proxy target, read at build time by next.config.ts's
# rewrites(). Production/preview get their own value from Vercel project
# env vars; local dev falls back to the FastAPI dev server.
HCG_API_ORIGIN=http://127.0.0.1:8000

# Shared secret Vercel Cron sends as `Authorization: Bearer $CRON_SECRET`
# when it calls app/api/cron/keepalive/route.ts (F08). Set on the Vercel
# project (production target); for local testing, export the same value
# and curl with the matching header.
CRON_SECRET=
